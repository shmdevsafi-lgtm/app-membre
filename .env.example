# Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit secrets to git - use Netlify environment variables instead

# ============================================
# SUPABASE - CLIENT SIDE (VITE_ prefix)
# ============================================
# Available in browser JavaScript
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# SUPABASE - SERVER SIDE (No VITE prefix)
# ============================================
# Only available on the server
# ANON_KEY: Used for regular database operations
# SERVICE_ROLE_KEY: ⚠️ VERY SECRET - Admin access to database

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # ⚠️ KEEP SECRET
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # ⚠️ KEEP SECRET

# ⚠️ REQUIRED for /api/auth/login and requireAuth to work at all.
# Without this set on Netlify (Site settings → Environment variables),
# every login and every authenticated request will fail with a 500/401.
JWT_SECRET=generate-a-long-random-string-and-keep-it-secret

# ============================================
# ANDROID APK (Capacitor) — client-side only
# ============================================
# The packaged APK has no local backend: every relative /api/* call must be
# prefixed with the full URL of the deployed Netlify site (see
# client/lib/api-config.ts). Leave empty for normal web builds; set this as
# a GitHub Actions secret/variable for the APK build workflow.
VITE_API_BASE_URL=https://your-site.netlify.app

# ============================================
# BADGE ENCRYPTION (QR membre chiffré)
# ============================================
# Clé partagée avec le portail chefs (AES-256, 32 octets, base64).
# IDENTIQUE dans les deux repos -- ne jamais la regénérer ici seul.
# Jamais la vraie valeur dans ce fichier ni dans .env : uniquement en
# secret GitHub Actions (CI) et en variable d'environnement Netlify
# (build web) -- voir la section Netlify plus bas.
VITE_BADGE_ENCRYPTION_KEY=base64-encoded-32-byte-key-here

# ============================================
# EMAIL SMTP (compte personnel)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-application-password
CORS_ORIGIN=http://localhost:8080

# ============================================
# APPLICATION
# ============================================
PING_MESSAGE="ping pong"

# ============================================
# INSTRUCTIONS FOR LOCAL DEVELOPMENT
# ============================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all values with your credentials
# 3. Make sure .env.local is in .gitignore
# 4. Run: pnpm dev
#
# IMPORTANT: Never commit .env.local to Git!

# ============================================
# INSTRUCTIONS FOR NETLIFY DEPLOYMENT
# ============================================
# 1. Do NOT commit this file with real values
# 2. Get your credentials from:
#    - Supabase: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# 3. In Netlify Dashboard:
#    - Go to: Site settings → Build & deploy → Environment
#    - Click: "Add environment variables"
#    - Add these variables:
#
#    PUBLIC VARIABLES:
#    VITE_SUPABASE_URL
#    VITE_SUPABASE_ANON_KEY
#
#    SECRET VARIABLES (Mark as "Secret"):
#    SUPABASE_URL
#    SUPABASE_ANON_KEY
#    SUPABASE_SERVICE_ROLE_KEY (🔴 Most secret!)
#
# 4. Redeploy: Deploys → Trigger deploy → Deploy site

# ============================================
# VARIABLE USAGE IN CODE
# ============================================
# CLIENT CODE (React):
#   import.meta.env.VITE_SUPABASE_URL
#   import.meta.env.VITE_SUPABASE_ANON_KEY
#
# SERVER CODE (Express):
#   process.env.SUPABASE_URL
#   process.env.SUPABASE_SERVICE_ROLE_KEY

# ============================================
# SECURITY CHECKLIST
# ============================================
# ✅ VITE_SUPABASE_ANON_KEY - Can be public (client)
# 🔴 SUPABASE_SERVICE_ROLE_KEY - NEVER commit, mark as "Secret" in Netlify
