.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.config/
# SECURITY FIX: this used to be "!.env", which force-committed the
# real .env (with live Supabase service_role key, JWT_SECRET and
# SMTP_PASS in plain text) to the repository -- see the note at the
# top of .env.example. .env is now correctly ignored like any other
# repo. If you still have the old .env committed in your git history,
# rotating the secrets above is not optional: they must be treated as
# permanently compromised even after this fix.
.env
.env.local
