legacy-peer-deps=true

# Forces pnpm to install a flat/hoisted node_modules (like classic npm),
# instead of its default symlinked structure.
#
# Why: Netlify Functions' bundler (esbuild) resolves each function's
# dependencies (express, jsonwebtoken, @supabase/supabase-js, bcrypt, etc.)
# by walking node_modules on disk. pnpm's default symlinked layout
# (node_modules/.pnpm/...) confuses that resolution and produces
# "Cannot find module 'express'" at runtime in the deployed function, even
# though `pnpm install` succeeded during the build.
node-linker=hoisted
